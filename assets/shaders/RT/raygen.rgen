#version 460
#extension GL_EXT_ray_tracing : require

struct HitPayload {
    float hitDistance;
    vec3 worldNormal;
    int objectIndex;
    int hitType;
    bool isBackface;
    int bounceCount;
    vec3 albedo;
    uint seed;
    vec3 accumulatedLight;
    vec3 throughput;
};

layout(binding = 0, set = 0) uniform accelerationStructureEXT topLevelAS;
layout(binding = 1, set = 0, rgba8) uniform image2D outputImage;
layout(binding = 2, set = 0) uniform CameraUBO {
    mat4 invView;
    mat4 invProj;
    uint frameIndex;
    uint accumulatedSamples;
} camera;


layout(binding = 5, set = 0, rgba32f) uniform image2D accumulationImage;

layout(location = 0) rayPayloadEXT HitPayload payload;

uint pcgHash(uint seed) {
    uint state = seed * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float randomFloat(inout uint seed) {
    seed = pcgHash(seed);
    return float(seed) / 4294967295.0;
}

vec3 vectorInUnitSphere(inout uint seed) {
    return normalize(vec3(
        randomFloat(seed) * 2.0 - 1.0,
        randomFloat(seed) * 2.0 - 1.0,
        randomFloat(seed) * 2.0 - 1.0
    ));
}

vec3 randomOnHemisphere(inout uint seed, vec3 normal) {
    vec3 onUnitSphere = vectorInUnitSphere(seed);
    return (dot(onUnitSphere, normal) > 0.0) ? onUnitSphere : -onUnitSphere;
}

vec3 randomVec3(inout uint seed) {
    return vec3(
        randomFloat(seed) - 0.5,
        randomFloat(seed) - 0.5,
        randomFloat(seed) - 0.5
    );
}

float randomValueNormalDistribution(inout uint seed) {
    float theta = 2.0 * 3.14159265 * randomFloat(seed);
    float rho = sqrt(-2.0 * log(randomFloat(seed)));
    return rho * cos(theta);
}

void main() {
    const vec2 pixelCenter = vec2(gl_LaunchIDEXT.xy) + vec2(0.5);
    const vec2 inUV = pixelCenter / vec2(gl_LaunchSizeEXT.xy);
    vec2 d = inUV * 2.0 - 1.0;

    vec4 origin = camera.invView * vec4(0, 0, 0, 1);
    vec4 target = camera.invProj * vec4(d.x, d.y, 1, 1);
    vec4 direction = camera.invView * vec4(normalize(target.xyz), 0);

    uint baseSeed = uint(gl_LaunchIDEXT.x + gl_LaunchIDEXT.y * gl_LaunchSizeEXT.x);
    baseSeed *= camera.frameIndex;

    const int samplesPerPixel = 4; // tune this
    vec3 color = vec3(0.0);

    for (int s = 0; s < samplesPerPixel; s++) {
        payload.hitDistance = -1.0;
        payload.worldNormal = vec3(0.0);
        payload.objectIndex = -1;
        payload.hitType = 0;
        payload.isBackface = false;
        payload.bounceCount = 0;
        payload.seed = pcgHash(baseSeed + uint(s) * 9781u); // distinct seed per sample
        payload.accumulatedLight = vec3(0.0);
        payload.throughput = vec3(1.0);

        traceRayEXT(topLevelAS, gl_RayFlagsOpaqueEXT, 0xff, 0, 0, 0, origin.xyz, 0.001, direction.xyz, 10000.0, 0);

        color += payload.accumulatedLight;
    }
    color /= float(samplesPerPixel);

    ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
    vec3 previousAccum = imageLoad(accumulationImage, pixel).rgb;
    vec3 newAccum;

    if (camera.accumulatedSamples == 0u) {
        newAccum = color;
    } else {
        float sampleCount = float(camera.accumulatedSamples + 1u);
        newAccum = previousAccum + (color - previousAccum) / sampleCount;
    }

    imageStore(accumulationImage, pixel, vec4(newAccum, 1.0));
    imageStore(outputImage, pixel, vec4(newAccum, 1.0));
}
